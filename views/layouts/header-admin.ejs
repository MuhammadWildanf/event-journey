                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= active === 'booths' ? 'active' : '' %>" href="/admin/booths">Booth</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= active === 'users' ? 'active' : '' %>" href="/admin/users">Users</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link <%= active === 'quota' ? 'active' : '' %>" href="/admin/quota">Quota</a>
                    </li>

                </ul>
