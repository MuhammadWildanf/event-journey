<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || "SCM Digital Day 2025" %></title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@400&display=swap" />

    <meta name="description" content="Official registration portal for Pertamina's SCM Digital Day 2025 Event.">
    <meta name="author" content="PT Pertamina">
    <meta name="organization" content="PT Pertamina (Persero)">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /*****************************************
         BASE LAYOUT (tanpa scroll)
        ******************************************/
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: url("/assets/img/bg-dashboard.png") no-repeat center center / cover;
            font-family: "Poppins", sans-serif;
            color: #fff;

            display: flex;
            justify-content: center;
            align-items: center;

            overflow: hidden;
            /* NO SCROLL */
        }


        /*****************************************
         WRAPPER — device-friendly
        ******************************************/
        .dashboard-wrapper {
            width: min(100%, 390px);
            min-width: 320px;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transform-origin: top center;
        }

        /* Desktop auto-zoom */
        @media (min-width: 900px) {
            body {
                justify-content: center;
                align-items: flex-start;
            }

            .dashboard-wrapper {
                transform: scale(1.15);
            }
        }

        @media (min-width: 1400px) {
            .dashboard-wrapper {
                transform: scale(1.30);
            }
        }

        @media (min-width: 1700px) {
            .dashboard-wrapper {
                transform: scale(1.45);
            }
        }


        /*****************************************
         HEADER
        ******************************************/
        header {
            width: 100%;
            padding: 1.3rem 1.4rem;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 10;
        }


        /*****************************************
         MAIN
        ******************************************/
        main {
            flex: 1;
            margin-top: 80px;
            overflow: hidden;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }


        /*****************************************
 GRID RESPONSIVE
******************************************/
        .dashboard-grid {
            width: 100%;
            padding: 10px 12px 16px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        /* HP kecil (iPhone SE, Galaxy A03, 360px) */
        @media (max-width: 380px) {
            .dashboard-grid {
                gap: 8px;
                padding: 8px 10px;
            }

            /* Square card lebih pendek */
            .grid-item.square .booth-card {
                aspect-ratio: 0.88/1;
                /* 12% LEBIH PENDEK */
            }

            /* Scan card juga sedikit dipendekkan */
            .grid-item.wide .booth-card {
                aspect-ratio: 15.5/7;
            }
        }


        /*****************************************
         CARDS
        ******************************************/
       .grid-item.wide { grid-column: span 2; }

        .booth-card {
            width: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }

        /* Ratio mengikuti asset PNG */
        .grid-item.wide .booth-card {
            aspect-ratio: 17/7;
        }

        .grid-item.square .booth-card {
            aspect-ratio: 1/1;
        }

        /* Image Cards */
        .card-scan {
            background-image: url('/assets/cards/scan.png');
        }

        .card-lunch {
            background-image: url('/assets/cards/lunch.png');
        }

        .card-souvenir {
            background-image: url('/assets/cards/souvenir.png');
        }

        .card-photo {
            background-image: url('/assets/cards/photo.png');
        }

        .card-games {
            background-image: url('/assets/cards/games.png');
        }

        .card-booth {
            background-image: url('/assets/cards/booth.png');
        }

        /* Disable state */
        .not-visited {
            filter: grayscale(40%) brightness(70%);
            position: relative;
        }

        .not-visited::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 40, 90, .35);
        }


        /*****************************************
         LOGOUT BUTTON
        ******************************************/
        .logout-btn {
            width: 42px;
            height: 42px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>

</head>

<body>