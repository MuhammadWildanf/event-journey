<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || "SCM Digital Day 2025" %>
    </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@400&display=swap" />


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


       <style>
        /* =====================
           BASE LAYOUT
        ====================== */
        body {
            background: url("/assets/img/bg-dashboard.png") no-repeat center top/cover;
            font-family: 'Poppins', sans-serif;
            color: #fff;
            min-height: 100vh;
           overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1.2rem 1.5rem;
            z-index: 10;
        }

        main {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding-top: 6rem;
            padding-bottom: 2rem;
        }

        /* =====================
           GRID WRAPPER (PHONE UI)
        ====================== */
        .dashboard-grid {
            width: 100%;
            max-width: 390px; /* ukuran paling dekat dengan HP kamu */
            margin: 0 auto;
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(2, 1fr);
            padding: 20px 12px 40px;
        }

        /* Desktop scaling (NO ZOOM berlebihan) */
        @media (min-width: 1024px) {
            body {
                display: flex;
                justify-content: center;
                align-items: flex-start;
                transform: scale(1.15);
                transform-origin: top center;
            }
        }

        /* =====================
           CARD BASE
        ====================== */
        .grid-item {
            width: 100%;
        }

        .grid-item.wide {
            grid-column: span 2;
        }

        .booth-card {
            width: 100%;
            background-size: contain !important;
            background-position: center !important;
            background-repeat: no-repeat !important;
            border-radius: 0 !important; /* NO RADIUS */
            overflow: hidden;

            /* Supaya PNG tidak terpotong */
            padding: 16px 0;
        }

        /* RATIO CARD – mengikuti desain PNG */
        .grid-item.wide .booth-card {
            aspect-ratio: 18/7; 
        }

        .grid-item.square .booth-card {
            aspect-ratio: 1/1;
        }

        /* =====================
           CARD IMAGES
        ====================== */
        .card-scan { background-image: url('/assets/cards/scan.png'); }
        .card-lunch { background-image: url('/assets/cards/lunch.png'); }
        .card-souvenir { background-image: url('/assets/cards/souvenir.png'); }
        .card-photo { background-image: url('/assets/cards/photo.png'); }
        .card-games { background-image: url('/assets/cards/games.png'); }
        .card-booth { background-image: url('/assets/cards/booth.png'); }

        /* =====================
           NOT VISITED EFFECT
        ====================== */
        .not-visited {
            pointer-events: none;
            position: relative;
            filter: grayscale(25%) brightness(80%);
        }

        .not-visited::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 45, 90, 0.45);
        }

        /* Hover (Desktop only) */
        @media (hover:hover) {
            .booth-card:hover {
                transform: translateY(-4px);
                transition: 0.25s;
            }
        }

        /* Logout button */
        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            transition: 0.25s ease;
        }

        .logout-btn:hover {
            transform: translateY(-2px);
        }

        .logout-icon {
            font-size: 22px;
        }
    </style>

    <!-- Datatables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css">

    <!-- jQuery (DataTables butuh jQuery) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- Datatables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.5/jszip.min.js"></script>
</head>

<body>