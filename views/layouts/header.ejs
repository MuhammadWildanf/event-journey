<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title || "SCM Digital Day 2025" %>
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:wght@400&display=swap" />
    <meta name="description" content="Official registration portal for Pertamina's SCM Digital Day 2025 Event.">
    <meta name="author" content="PT Pertamina">
    <meta name="organization" content="PT Pertamina (Persero)">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* =======================================
   BASE LAYOUT — FIXED ANTI TERPOTONG
======================================== */
        body {
            background: url("/assets/img/bgnew.png") no-repeat center top/cover;
            font-family: "Montserrat", sans-serif;
            color: #fff;
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* =======================================
   GRID WRAPPER
======================================== */
        .dashboard-grid {
            width: 100%;
            max-width: 300px;
            /* Adjust grid max-width for proper fit */
            margin: 0 auto;
            display: grid;
            gap: 16px;
            grid-template-columns: repeat(2, 1fr);
            padding: 30px 16px 40px;
        }

        /* =======================================
   CARD BASE
======================================== */
        .grid-item {
            width: 100%;
            padding: 0;
        }

        .grid-item.wide {
            grid-column: span 2;
        }

        .booth-card {
            width: 100%;
            background-size: cover !important;
            background-position: center center !important;
            background-repeat: no-repeat !important;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            overflow: hidden;
            border-radius: 8px;
        }

        /* =======================================
   FIX CARD ASPECT RATIO TO MATCH IMAGES
======================================== */
        .card-scan {
            background-image: url('/assets/cards/scan.png');
            aspect-ratio: 998 / 248;
            /* Aspect ratio for the scan image */
        }

        .card-lunch {
            background-image: url('/assets/cards/lunch.png');
            /* Add background image */
            aspect-ratio: 490 / 330;
            /* Aspect ratio for the lunch card */
        }

        .card-souvenir {
            background-image: url('/assets/cards/souvenir.png');
            /* Add background image */
            aspect-ratio: 490 / 330;
            /* Aspect ratio for the souvenir card */
        }

        .card-photo {
            background-image: url('/assets/cards/photo.png');
            /* Add background image */
            aspect-ratio: 490 / 330;
            /* Aspect ratio for the photo card */
        }

        .card-games {
            background-image: url('/assets/cards/games.png');
            /* Add background image */
            aspect-ratio: 490 / 330;
            /* Aspect ratio for the games card */
        }

        .card-booth {
            background-image: url('/assets/cards/booth.png');
            aspect-ratio: 998 / 248;
            /* Keeping booth card aspect ratio like the scan image */
        }

        /* =======================================
   NOT VISITED STATE
======================================== */
        .not-visited {
            pointer-events: none;
            filter: grayscale(25%) brightness(80%);
            position: relative;
        }

        .not-visited::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 45, 90, 0.45);
        }

        .disabled {
            pointer-events: none;
            opacity: 0.5;
            filter: grayscale(25%) brightness(80%);
        }

        /* =======================================
   DOWNLOAD BUTTON
======================================== */
        .download-guide {
            grid-column: span 2;
            text-align: center;
            margin-top: 12px;
            display: flex;
            justify-content: center;
        }

        .download-link {
            display: inline-block;
            padding: 14px 28px;
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            border-radius: 6px;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow:
                0 10px 30px rgba(0, 200, 255, 0.06),
                0 0 40px rgba(120, 240, 255, 0.04);
            text-shadow:
                0 2px 20px rgba(0, 220, 255, 0.12),
                0 1px 2px rgba(0, 0, 0, 0.6);
            transition: transform .18s ease, box-shadow .18s ease;
        }

        .download-link:hover {
            transform: translateY(-4px);
            box-shadow:
                0 18px 40px rgba(0, 200, 255, 0.12),
                0 0 60px rgba(120, 240, 255, 0.08);
        }

        /* Make sure link is readable on small screens */
        @media (max-width: 480px) {
            .download-link {
                padding: 12px 20px;
                font-size: 0.98rem;
            }
        }
    </style>

</head>

<body>