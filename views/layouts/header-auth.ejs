<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <meta name="description" content="Official registration portal for Pertamina's SCM Digital Day 2025 Event.">
    <meta name="author" content="PT Pertamina">
    <meta name="organization" content="PT Pertamina (Persero)">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* === BACKGROUND & BODY === */
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: url("/assets/img/bg.png") no-repeat center center / cover;
            font-family: "Poppins", sans-serif;
            overflow: hidden;              /* no scroll */
            display: flex;                 /* center wrapper */
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        /* === WRAPPER YANG DI-SCALE === */
        .auth-wrapper {
            position: relative;
            width: 390px;                  /* desain dasar mobile */
            transform-origin: top center;
        }

        /* LOGO */
        .auth-logo {
            width: 260px;
            margin-bottom: 20px;
        }

        /* SECTION DALAM AUTH */
        .auth-page {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            animation: fadeIn 0.8s ease;
        }

        /* JUDUL */
        .auth-title {
            font-weight: 700;
            font-size: 1.7rem;
            margin-top: 10px;
            margin-bottom: 18px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #fff;
            text-shadow: 0 0 10px rgba(0, 255, 200, 0.3);
        }

        /* FORM */
        .auth-form {
            width: 100%;
            max-width: 360px;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        /* INPUT BOX PUTIH */
        .input-box {
            position: relative;
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 14px;
            padding: 0.85rem 1.1rem;
            transition: 0.25s ease;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
        }

        .input-box:focus-within {
            border-color: #b4ff30;
            box-shadow: 0 0 12px rgba(180, 255, 48, 0.6);
        }

        .input-box i {
            color: #888;
            font-size: 1.1rem;
            margin-right: 10px;
        }

        .input-box input {
            flex: 1;
            border: none;
            background: transparent;
            color: #333;
            outline: none;
            font-size: 0.95rem;
        }

        .input-box input::placeholder {
            color: #999;
        }

        .input-box button {
            background: none;
            border: none;
            color: #999;
            cursor: pointer;
            font-size: 1.1rem;
            margin-left: 6px;
        }

        .password-info {
            display: block;
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.70);
            margin-top: 4px;
        }

        /* BUTTON NEON */
        .btn-auth {
            width: 100%;
            border-radius: 14px;
            padding: 0.85rem;

            background: linear-gradient(90deg, #b4ff30, #78ff00);
            border: 2px solid #d7ff76;

            color: #003300;
            font-weight: 700;
            font-size: 1rem;

            box-shadow: 0 0 16px rgba(180, 255, 48, 0.4);
            transition: 0.2s ease;
        }

        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 22px rgba(180, 255, 48, 0.7);
        }

        /* LINK BAWAH */
        .auth-link {
            margin-top: 12px;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.85);
        }

        .auth-link a {
            color: #3af0af;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-link a:hover {
            text-decoration: underline;
        }

        /* ANIMASI */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* SCALE UNTUK LAYAR BESAR */
        @media (min-width: 768px) {
            .auth-wrapper {
                transform: scale(1.1);
            }
        }

        @media (min-width: 1200px) {
            .auth-wrapper {
                transform: scale(1.3);
            }
        }

        @media (min-width: 1600px) {
            .auth-wrapper {
                transform: scale(1.5);
            }
        }

        /* MOBILE: NATURAL, TANPA SCALE */
        @media (max-width: 480px) {
            body {
                align-items: center;
                justify-content: center;
            }

            .auth-wrapper {
                width: 92%;
                transform: none;
            }

            .auth-logo {
                width: 240px;
                margin-bottom: 16px;
            }
        }
    </style>
</head>

<body class="<%= bodyClass || '' %>">
