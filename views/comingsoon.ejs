<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coming Soon - SCM Digital Day 2025</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: url('/assets/img/bg.png') no-repeat center center / cover;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #fff;
            font-family: "Montserrat-SemiBold", sans-serif;
            text-align: center;
        }

        .logo {
            width: 300px;
            margin-bottom: 2rem;
            animation: fadeInLogo 1s ease-in-out;
        }

        .coming-soon-img {
            width: 80%;
            max-width: 800px;
            margin-bottom: 1.5rem;
        }

        .separator {
            margin: 1.5rem 0;
            border-top: 2px solid rgba(255, 255, 255, 0.5);
            width: 60%;
            margin-left: auto;
            margin-right: auto;
        }

        .location-img, .date-img {
            width: 70%;
            max-width: 600px;
            margin-bottom: 1rem;
        }

        @keyframes fadeInLogo {
            0% {
                opacity: 0;
                transform: translateY(-50px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    <div class="container"> 
        <img src="/assets/img/logo.png" alt="SCM Digital Day" class="logo">
        <img src="/assets/img/comingsoon.png" alt="Coming Soon" class="coming-soon-img">
        <img src="/assets/img/date.png" alt="Date" class="date-img">
        <div class="separator"></div>
        <img src="/assets/img/location.png" alt="Location" class="location-img">
    </div>
</body>

</html>
