<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coming Soon - SCM Digital Day 2025</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: url("/assets/img/bg.png") no-repeat center center / cover;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: #fff;
            font-family: "Poppins", sans-serif;
            text-align: center;
        }

        .logo {
            width: 300px;
            margin-bottom: 2rem;
            animation: fadeInLogo 1s ease-in-out;
        }

        h1 {
            font-weight: 700;
            font-size: 2rem;
            letter-spacing: 8px;
            margin-bottom: 1.5rem;
            text-transform: uppercase;
            color: #fff;
            animation: fadeInText 1.5s ease-in-out;
        }

        p {
            font-size: 1.2rem;
            color: rgba(255, 255, 255, 0.8);
            margin-bottom: 2rem;
            animation: fadeInText 2s ease-in-out;
        }

        .btn-home {
            background: linear-gradient(90deg, #3af0af, #32ffb2);
            color: #00333a;
            font-weight: 600;
            border: none;
            border-radius: 30px;
            padding: 1rem 3rem;
            font-size: 1.5rem;
            transition: 0.3s ease;
            animation: fadeInText 2.5s ease-in-out;
        }

        .btn-home:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 12px rgba(50, 255, 178, 0.5);
        }

        .info {
            font-size: 1.3rem;
            margin: 2rem 0;
            color: #fff;
        }

        .location {
            font-size: 1.5rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.8);
        }

        @keyframes fadeInLogo {
            0% {
                opacity: 0;
                transform: translateY(-50px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInText {
            0% {
                opacity: 0;
                transform: translateY(50px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body>
    <div class="container">
        <img src="/assets/img/logo.png" alt="SCM Digital Day" class="logo">
        <h1>Coming Soon</h1>
        <div class="info">
            <p>Selasa-Rabu, 25-26 November 2025</p>
            <p class="location">Multifunction Room 2nd floor, PHE Tower</p>
        </div>
    </div>
</body>

</html>