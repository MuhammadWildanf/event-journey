<%- include("../layouts/header", { title: "Booth" , bodyClass: "page-booth" }) %>

<style>
    /* Booth list card - slightly reduced padding/size so the list fits better */
    .booth-list-card {
        padding: 10px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.92);
        color: #000;
        font-weight: 600;
        margin-bottom: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .booth-list-card i {
        font-size: 1.1rem;
    }

    .booth-visited {
        background: linear-gradient(135deg, #C65AFF, #8A23D9);
        color: white;
        border: 2px solid #F0B6FF;
    }

    /* Wrapper that limits height and allows scrolling so the BACK button stays visible */
    .booth-list-wrapper {
        max-height: calc(100vh - 220px);
        /* leave room for header and back button */
        overflow-y: auto;
        padding-right: 6px;
        /* avoid content hiding behind scrollbar */
        -webkit-overflow-scrolling: touch;
        margin-bottom: 0.75rem;
    }

    .btn-back-custom {
        display: block;
        width: 100%;
        padding: 12px 0;
        margin-top: 0.9rem;
        text-decoration: none;
        border-radius: 12px;
        background: #0c2340;
        color: #ffffff;
        font-size: 0.98rem;
        font-weight: 600;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow:
            0 0 10px rgba(0, 255, 255, 0.15),
            0 0 16px rgba(0, 255, 255, 0.06);
    }

    .disabled-booth {
        pointer-events: none;
        opacity: 0.55;
        filter: grayscale(100%);
    }

    /* Small screens: give slightly more room for the button */
    @media (max-width: 576px) {
        .booth-list-wrapper {
            max-height: calc(100vh - 180px);
        }

        .booth-list-card {
            padding: 9px;
            font-size: 0.95rem;
        }

        .btn-back-custom {
            padding: 11px 0;
            font-size: 0.95rem;
        }
    }

    /* Tidy up header in page-booth so "Welcome / name" doesn't sit too close to the top */
    .page-booth header {
        padding: 18px 12px 8px;
        margin-bottom: 6px;
    }

    .page-booth header small {
        display: block;
        color: rgba(255, 255, 255, 0.9);
        font-size: 0.95rem;
        line-height: 1;
    }

    .page-booth header strong {
        display: block;
        font-size: 1.25rem;
        margin-top: 6px;
        color: #fff;
        letter-spacing: 0.2px;
    }

    /* Booth title (icon + h3) alignment and visual polish */
    .booth-title {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        color: #fff;
    }

    .booth-title .material-symbols-rounded {
        font-size: 22px;
        /* icon size */
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.06);
        color: #fff;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18) inset;
    }

    .booth-title h3 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
</style>

<% const visitedSafe=visited || {}; const sortedBooths=Object.entries(booths).sort((a, b)=> {
        // --------------------------
        // PRIORITAS 1: visited duluan
        // --------------------------
        const visitedA = visitedSafe[a[0]] ? 1 : 0;
        const visitedB = visitedSafe[b[0]] ? 1 : 0;

        if (visitedA !== visitedB) {
        return visitedB - visitedA;
        }

        // --------------------------
        // PRIORITAS 2: urut nomor booth
        // Key: "10_scm_regional_4"
        // Ambil angka sebelum underscore
        // --------------------------
        const getNum = (key) => {
        const match = key.match(/^(\d+)_/);
        return match ? parseInt(match[1]) : 9999; // fallback kalau tidak ada angka
        };

        return getNum(a[0]) - getNum(b[0]);
        });
        %>


<main class="text-center page-booth">
    <div class="container">
        <div class="booth-title d-flex align-items-center justify-content-center gap-2 mb-4">
            <span class="material-symbols-rounded">storefront</span>
            <h3>
                BOOTH
            </h3>
        </div>
        <div class="booth-list-wrapper">
            <div class="row justify-content-center">

                <% sortedBooths.forEach(([key, booth])=> { %>
                <% const isVisited=visitedSafe[key]===true; %>

                <div class="col-12 mb-2">
                    <% if (isVisited) { %>

                    <!-- ✔ BOOTH SUDAH DIKUNJUNGI → BISA DIKLIK -->
                    <a href="/booth/<%= key %>" class="text-decoration-none">
                        <div class="booth-list-card booth-visited">
                            <i class="bi bi-shop"></i>
                            <%= booth.name %>
                        </div>
                    </a>

                    <% } else { %>

                    <!-- ❌ BOOTH BELUM DIKUNJUNGI → DISABLE -->
                    <div class="booth-list-card disabled-booth">
                        <i class="bi bi-shop"></i>
                        <%= booth.name %>
                    </div>

                    <% } %>
                </div>

                <% }) %>

            </div>
        </div>

        <a href="/dashboard" class="btn-back-custom">BACK</a>
    </div>

</main>

<%- include("../layouts/footer") %>