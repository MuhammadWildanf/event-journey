<%- include("../layouts/header", { title: "Booth" , bodyClass: "page-booth" }) %>

    <style>
        .booth-wrapper {
            min-height: 100vh;
            padding-top: 6rem;
            padding-bottom: 4rem;
        }

        .review-box {
            background: #ffffff;
            border-radius: 18px;
            padding: 24px;
            width: 85%;
            color: #000;
            box-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
        }

        .rating {
            display: flex;
            flex-direction: row-reverse;
            justify-content: center;
            gap: 18px;
            font-size: 2.7rem;
            cursor: pointer;
        }

        .rating input {
            display: none;
        }

        .rating label {
            position: relative;
            cursor: pointer;
            opacity: 1;
            /* outline harus selalu terlihat */
        }

        /* Bintang outline default */
        .rating label::before {
            content: '☆';
            color: #FFD700;
            transition: .2s;
        }

        /* Bintang aktif (filled) */
        .rating input:checked~label::before,
        .rating label:hover::before,
        .rating label:hover~label::before {
            content: '★';
            color: #FFD700;
        }

        .btn-send {
            width: 85%;
            margin: 20px auto 0;
            padding: 14px 0;
            border-radius: 12px;

            background: linear-gradient(90deg, #b4ff30, #78ff00);
            border: 2px solid #d7ff76;
            color: #003300;
            font-weight: 700;
            font-size: 1.2rem;
            box-shadow: 0 0 18px rgba(180, 255, 48, 0.6);
        }

        .btn-back-custom {
            width: 85%;
            margin: 40px auto 0;
            padding: 14px 0;
            border-radius: 14px;
            background: #0c2340;
            color: #fff;
            font-weight: 600;
            text-align: center;
            text-decoration: none;

        }
    </style>

    <div class="text-white text-center d-flex flex-column align-items-center booth-wrapper">

        <div class="booth-title d-flex align-items-center justify-content-center gap-2">
            <span class="material-symbols-rounded">storefront</span>
            <h3>
                <%= boothData.name %>
            </h3>
        </div>

        <p class="text-white-50 mb-4">
            <%= boothData.description || '' %>
        </p>

        <% if (!userReview) { %>

            <form action="/booth/<%= boothType %>/review" method="POST"
                class="w-100 d-flex flex-column align-items-center">

                <div class="review-box mb-4">

                    <h5 class="mb-3 text-center">Give Your Review</h5>

                    <!-- Rating inside card -->
                    <div class="rating mb-3 d-flex justify-content-center">
                        <% for (let i=5; i>= 1; i--) { %>
                            <input type="radio" name="rating" value="<%= i %>" id="star<%= i %>">
                            <label for="star<%= i %>"></label>
                            <% } %>
                    </div>

                    <!-- Textarea inside card -->
                    <textarea name="comment" class="form-control border-0 mt-3" rows="4"
                        placeholder="Write your review..." style="background:none;resize:none;outline:none;"></textarea>

                </div>

                <button class="btn-send">SEND</button>
            </form>


            <% } else { %>

                <div class="review-box mt-3 text-start">
                    <h5>Your Review</h5>
                    <strong>
                        <%= userReview.user %>
                    </strong> — ⭐ <%= userReview.rating %>
                        <p class="mt-2 mb-0">
                            <%= userReview.comment %>
                        </p>
                </div>

                <% } %>

                    <a href="/booth" class="btn-back-custom">BACK</a>
    </div>


    <script>
        document.querySelector("form").addEventListener("submit", function (e) {
            const rating = document.querySelector("input[name='rating']:checked");

            // HANYA rating yang wajib
            if (!rating) {
                e.preventDefault();
                Swal.fire({
                    icon: "warning",
                    title: "Rating Required",
                    text: "Silakan pilih rating terlebih dahulu!",
                    confirmButtonColor: "#d33",
                });
                return;
            }
        });
    </script>




    <%- include("../layouts/footer") %>