<%- include("../../layouts/header-admin", { title: "Souvenir Quota Detail" }) %>

<div class="container mt-4">

    <h3>Souvenir Quota Detail</h3>

    <div class="card mt-3">
        <div class="card-body">
            <p><strong>Quota:</strong> <%= quota %></p>
            <p><strong>Used:</strong> <%= used %></p>
            <p><strong>Remaining:</strong> <%= remaining %></p>

            <h5 class="mt-4">Users Who Took Souvenir Today</h5>

            <table class="table table-bordered mt-2">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (souvenirUsers.length === 0) { %>
                        <tr><td colspan="4" class="text-center">No users today</td></tr>
                    <% } %>

                    <% souvenirUsers.forEach((u, i) => { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= u.name %></td>
                            <td><%= u.email %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<%- include("../../layouts/footer") %>
