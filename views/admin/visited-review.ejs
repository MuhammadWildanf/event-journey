<%- include("../layouts/header-admin", { title: "Review Paling Cepat (Belum Claim Souvenir)" }) %>

<div class="container py-4">

    <h3 class="mt-4">User Visit ≥ 8 Booth & Belum Claim Souvenir</h3>

    <table id="reviewTable" class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>No</th>
                <th>UID</th>
                <th>Nama</th>
                <th>Email</th>
                <th>Visited Count</th>
                <th>Review Waktu</th>
            </tr>
        </thead>

        <tbody>
            <% results.forEach((u, i) => { %>
            <tr class="<%= i < 150 ? 'table-success' : '' %>">
                <td><%= i + 1 %></td>
                <td><%= u.id %></td>
                <td><%= u.name %></td>
                <td><%= u.email %></td>
                <td><%= u.visitedCount %></td>
                <td>
                    <% if (u.review_time) { %>
                        <%= new Date(u.review_time).toLocaleString("id-ID", { hour12:false }) %>
                    <% } else { %>
                        <span class="badge bg-secondary">Belum Review</span>
                    <% } %>
                </td>
            </tr>
            <% }) %>
        </tbody>
    </table>

</div>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#reviewTable').DataTable({
            pageLength: 10,
            order: [
                [5, 'asc'] // sort review paling cepat
            ]
        });
    });
</script>

<%- include("../layouts/footer") %>
