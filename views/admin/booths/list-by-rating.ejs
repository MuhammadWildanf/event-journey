<%- include("../../layouts/header-admin", { title: "Data Booth" }) %>
<div class="container">
    <h2 class="mb-4">Booth List</h2>

    <table id="boothRatingTable" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>#</th>
                <th>Booth Name</th>
                <th>Average Rating</th>
                <th>Total Reviews</th>
                <th>Rating Distribution</th>
            </tr>
        </thead>
        <tbody>
            <% booths.forEach((b, index) => { %>
            <tr>
                <td> <%= index + 1 %></td>
                <td><a href="/admin/booths/<%= b.key %>" class="text-decoration-none"><%= b.name %></a></td>
                <td><%= b.averageRating %> ⭐</td>
                <td><%= b.totalReviews %></td>
               <td>
   <% for(let i = 5; i >= 1; i--) { 
    const count = (b.ratingDistribution && !isNaN(b.ratingDistribution[i])) ? b.ratingDistribution[i] : 0;
    const total = b.totalReviews || 0;
    let perc = 0;
    if(total > 0){
        perc = (count / total) * 100;
        if(!isFinite(perc) || perc < 0) perc = 0;
        if(perc > 100) perc = 100;
    }
%>
<div class="d-flex align-items-center mb-1">
    <span class="me-2" style="width:20px;"><%= i %>⭐</span>
    <div class="progress flex-grow-1">
        <div class="progress-bar bg-success" role="progressbar"
            style="width: <%= perc.toFixed(0) %>%;" 
            aria-valuenow="<%= perc.toFixed(0) %>" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <span class="ms-2"><%= count %></span>
</div>
<% } %>
</td>


               
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<script>
    $(document).ready(function () {
        $('#boothRatingTable').DataTable({
            dom: 'Bfrtip',
            buttons: [
                'csv', 'excel', 'pdf', 'print'
            ]
        });
    });
</script>

<%- include("../../layouts/footer") %>