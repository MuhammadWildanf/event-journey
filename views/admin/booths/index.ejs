<%- include("../../layouts/header-admin", { title: "Data Booth" }) %>

<div class="container py-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Daftar Booth</h3>
        <div>
            <a href="/admin/booths/create" class="btn btn-primary">+ Booth Baru</a>
            <a href="/admin/booth-rating" class="btn btn-success">Booth Review</a>
        </div>
    </div>

    <table class="table table-striped table-bordered datatable">
        <thead class="table-dark">
            <tr>
                <th>Key</th>
                <th>Nama</th>
                <th>QR</th>
                <th>Aksi</th>
            </tr>
        </thead>

        <tbody>
            <% Object.entries(booths).forEach(([key, b])=> { %>
            <tr>
                <td><%= key %></td>
                <td><%= b.name %></td>
                <td>
                    <img src="<%= b.qrUrl %>" width="80" class="border rounded p-1 bg-white">
                </td>
                <td>
                    <a href="/admin/booths/<%= key %>" class="btn btn-sm btn-info">Detail</a>
                    <a href="/admin/booths/<%= key %>/edit" class="btn btn-sm btn-warning">Edit</a>
                    <a href="/admin/booths/<%= key %>/delete"
                       onclick="return confirm('Hapus booth ini?')"
                       class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
            <% }) %>
        </tbody>

    </table>

</div>

<%- include("../../layouts/footer") %>
