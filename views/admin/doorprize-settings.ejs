<%- include("../layouts/header-admin", { title: "Doorprize Settings" }) %>

<div class="container mt-4">

    <h3 class="mb-4">Doorprize Settings</h3>

    <div class="card">
        <div class="card-body">
            <form action="/admin/doorprize/settings" method="POST">
                
                <div class="mb-4">
                    <label class="form-label">
                        <strong>Spin Duration (seconds)</strong>
                    </label>
                    <input type="number" 
                           name="spinDuration" 
                           class="form-control" 
                           value="<%= spinDuration %>" 
                           min="2" 
                           max="30" 
                           step="0.5" 
                           required>
                    <small class="form-text text-muted">
                        Durasi putaran wheel dalam detik. Minimum: 2 detik, Maximum: 30 detik
                    </small>
                </div>

                <div class="alert alert-info">
                    <strong>Info:</strong> Setting ini akan mempengaruhi durasi animasi spin wheel di halaman doorprize. 
                    Semakin besar nilai, semakin lama wheel berputar.
                </div>

                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a href="/admin/doorprize/winners" class="btn btn-outline-primary">View Winners</a>
                <a href="/admin" class="btn btn-outline-secondary">Back to Dashboard</a>
            </form>
        </div>
    </div>

</div>

<%- include("../layouts/footer") %>

