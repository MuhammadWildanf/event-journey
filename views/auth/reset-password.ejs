<%- include("../layouts/header-auth", { title: "Reset Password || SCM Digital Day 2025", bodyClass: "page-auth" }) %>

<div class="auth-wrapper">
    <img src="/assets/img/logo.png" alt="SCM Digital Day 2025" class="auth-logo">
    <section class="auth-page">
        <h1 class="auth-title">RESET PASSWORD</h1>

        <form id="resetForm" class="auth-form">
            <div class="input-box">
                <i class="bi bi-envelope"></i>
                <input type="email" id="emailReset" name="email" placeholder="Enter your email">
            </div>

            <div class="input-box">
                <i class="bi bi-lock"></i>
                <input type="password" id="passwordReset" name="password" placeholder="New Numeric Password" pattern="\d+" inputmode="numeric">
            </div>

            <button type="submit" class="btn-auth">Reset Password</button>
        </form>

        <p class="auth-link">
            Back to <a href="/login">Login</a>
        </p>
    </section>
</div>

<script>
document.getElementById("resetForm").addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = document.getElementById("emailReset").value.trim();
    const password = document.getElementById("passwordReset").value.trim();

    if (!email || !password) {
        Swal.fire({ icon: "warning", title: "Attention", text: "Email and new password are required!", confirmButtonColor: "#3af0af" });
        return;
    }

    if (!/^\d+$/.test(password)) {
        Swal.fire({ icon: "warning", title: "Invalid Password", text: "Password must be numeric.", confirmButtonColor: "#3af0af" });
        return;
    }

    if (password.length < 6) {
        Swal.fire({ icon: "warning", title: "Password Too Short", text: "Password must be at least 6 digits.", confirmButtonColor: "#3af0af" });
        return;
    }

    if (password.length > 32) {
        Swal.fire({ icon: "warning", title: "Password Too Long", text: "Password must be at most 32 digits.", confirmButtonColor: "#3af0af" });
        return;
    }

    try {
        const res = await fetch("/reset-password", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, password }),
        });

        const text = await res.text();

        if (res.ok) {
            Swal.fire({ icon: "success", title: "Success", text: text, confirmButtonColor: "#3af0af" })
                .then(() => window.location.href = "/login");
        } else {
            Swal.fire({ icon: "error", title: "Error", text: text, confirmButtonColor: "#3af0af" });
        }
    } catch (err) {
        Swal.fire({ icon: "error", title: "Error", text: "Unable to reach server.", confirmButtonColor: "#3af0af" });
    }
});
</script>

<%- include("../layouts/footer") %>
