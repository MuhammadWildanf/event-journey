<%- include("../layouts/header-auth", { title: "Login || SCM Digital Day 2025" , bodyClass: "page-auth" }) %>

<div class="auth-wrapper">

    <!-- LOGO di dalam wrapper supaya ikut scale -->
    <img src="/assets/img/logo.png" alt="SCM Digital Day 2025" class="auth-logo">

    <section class="auth-page">

        <h1 class="auth-title">LOGIN</h1>

        <form id="loginForm" class="auth-form">
            <div class="input-box">
                <i class="bi bi-envelope"></i>
                <input type="email" id="emailLogin" name="email" placeholder="Email">
            </div>

            <div class="input-box">
                <i class="bi bi-lock"></i>
                <input type="password" id="passwordLogin" name="password" placeholder="Enter Password">
                <button type="button" id="togglePassword">
                    <i class="bi bi-eye"></i>
                </button>
            </div>

            <button type="submit" class="btn-auth">Login</button>
        </form>
        <p class="auth-link">
            <a href="/reset-password">Forgot Password?</a>
        </p>
        <p class="auth-link">
            New member? <a href="/register">Register now</a>
        </p>

    </section>
</div>

<script>
    // Toggle password visibility
    document.getElementById("togglePassword").addEventListener("click", function () {
        const passField = document.getElementById("passwordLogin");
        const icon = this.querySelector("i");
        if (passField.type === "password") {
            passField.type = "text";
            icon.classList.replace("bi-eye", "bi-eye-slash");
        } else {
            passField.type = "password";
            icon.classList.replace("bi-eye-slash", "bi-eye");
        }
    });

    // AJAX Login
    const loginForm = document.getElementById("loginForm");
    loginForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const email = document.getElementById("emailLogin").value.trim();
        const password = document.getElementById("passwordLogin").value.trim();

        if (!email || !password) {
            Swal.fire({
                icon: "warning",
                title: "Attention",
                text: "Email and password are required!",
                confirmButtonColor: "#3af0af",
            });
            return;
        }

        try {
            const res = await fetch("/login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    email,
                    password
                }),
            });

            if (res.ok) {
                Swal.fire({
                    icon: "success",
                    title: "Login Successful",
                    text: "Welcome to SCM Digital Day 2025!",
                    confirmButtonColor: "#3af0af",
                    timer: 1500,
                    showConfirmButton: false,
                }).then(() => {
                    window.location.href = "/dashboard";
                });
            } else {
                const text = await res.text();
                Swal.fire({
                    icon: "error",
                    title: "Login Failed",
                    text: text || "Email or password is incorrect!",
                    confirmButtonColor: "#3af0af",
                });
            }
        } catch (err) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: "Unable to reach the server.",
                confirmButtonColor: "#3af0af",
            });
        }
    });
</script>

<%- include("../layouts/footer") %>