<%- include("../layouts/header-auth", { title: "Register || SCM Digital Day 2025" , bodyClass: "page-auth" }) %>

    <div class="auth-wrapper">

        <!-- LOGO -->
        <img src="/assets/img/logo.png" alt="SCM Digital Day" class="auth-logo">

        <section class="auth-page">
            <h1 class="auth-title">REGISTRATION</h1>

            <form id="registerForm" class="auth-form">

                <!-- NAME -->
                <div class="input-box">
                    <i class="bi bi-person"></i>
                    <input type="text" id="name" name="name" placeholder="Full Name">
                </div>

                <!-- EMAIL -->
                <div class="input-box">
                    <i class="bi bi-envelope"></i>
                    <input type="email" id="email" name="email" placeholder="Email Address">
                </div>

                <!-- PASSWORD -->
                <div class="input-group-with-info" style="width: 100%; text-align:left;">
                    <small class="password-info mb-1 d-block">
                        Password must be at least 6 characters in numeric.
                    </small>
                    <div class="input-box">
                        <i class="bi bi-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Password" pattern="\d+"
                            inputmode="numeric">
                        <button type="button" class="togglePassword" data-target="password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- REPEAT PASSWORD -->
                <div class="input-box">
                    <i class="bi bi-lock-fill"></i>
                    <input type="password" id="repeatpassword" name="repeatpassword" placeholder="Confirm Password"
                        pattern="\d+" inputmode="numeric">
                    <button type="button" class="togglePassword" data-target="repeatpassword">
                        <i class="bi bi-eye"></i>
                    </button>   
                </div>


                <button type="submit" class="btn-auth">CREATE ACCOUNT</button>
                <p class="auth-link">Already have an account? <a href="/login">Login to Account</a></p>
            </form>
        </section>
    </div>

    <script>
        // === Toggle password visibility (multi-button) ===
        document.querySelectorAll(".togglePassword").forEach(btn => {
            btn.addEventListener("click", function () {
                const inputId = this.getAttribute("data-target");
                const passField = document.getElementById(inputId);
                const icon = this.querySelector("i");

                if (passField.type === "password") {
                    passField.type = "text";
                    icon.classList.replace("bi-eye", "bi-eye-slash");
                } else {
                    passField.type = "password";
                    icon.classList.replace("bi-eye-slash", "bi-eye");
                }
            });
        });
    </script>

    <script>

        const escapeHtml = (str = "") => String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");

        const registerForm = document.getElementById("registerForm");

        registerForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const name = document.getElementById("name").value.trim();
            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value.trim();
            const repeat = document.getElementById("repeatpassword").value.trim();

            if (!name || !email || !password || !repeat) {
                Swal.fire({
                    icon: "warning",
                    title: "Attention",
                    text: "All fields are required!",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            if (!/^\d+$/.test(password)) {
                Swal.fire({
                    icon: "warning",
                    title: "Invalid Password",
                    text: "Password must be numeric.",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            // Validasi untuk memastikan konfirmasi password hanya berisi angka
            if (!/^\d+$/.test(repeat)) {
                Swal.fire({
                    icon: "warning",
                    title: "Invalid Confirm Password",
                    text: "Confirm password must be numeric.",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            if (password.length < 6) {
                Swal.fire({
                    icon: "warning",
                    title: "Password Too Short",
                    text: "Password must be at least 6 characters.",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            if (password.length > 32) {
                Swal.fire({
                    icon: "warning",
                    title: "Password Too Long",
                    text: "Password must be at most 32 characters.",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            if (password !== repeat) {
                Swal.fire({
                    icon: "error",
                    title: "Passwords Do Not Match",
                    text: "Make sure password and confirm password are the same.",
                    confirmButtonColor: "#3af0af",
                });
                return;
            }

            const confirmResult = await Swal.fire({
                title: "Confirm Your Data",
                html: `
                    <p>Please confirm the information below:</p>
                    <p><strong>Name:</strong> ${escapeHtml(name)}</p>
                    <p><strong>Email:</strong> ${escapeHtml(email)}</p>
                    <small class="text-muted d-block mt-2">If correct, click "Confirm". To edit, click "Cancel".</small>
                `,
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Confirm",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#3af0af",
                focusConfirm: false,
            });

            if (!confirmResult.isConfirmed) {
                // user cancelled — return to form for editing
                return;
            }

            try {
                Swal.fire({
                    title: "Registering...",
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                const res = await fetch("/register", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        name,
                        email,
                        password
                    }),
                });

                Swal.close(); // close loading

                if (res.ok) {
                    Swal.fire({
                        icon: "success",
                        title: "Account Created",
                        text: "Your account has been created successfully.",
                        confirmButtonColor: "#3af0af",
                    }).then(() => {
                        window.location.href = "/dashboard";
                    });
                } else {
                    const text = await res.text();
                    Swal.fire({
                        icon: "error",
                        title: "Registration Failed",
                        text: text || "An error occurred, please try again later.",
                        confirmButtonColor: "#3af0af",
                    });
                }
            } catch (err) {
                Swal.fire({
                    icon: "error",
                    title: "Connection Error",
                    text: "Unable to reach the server.",
                    confirmButtonColor: "#3af0af",
                });
            }
        });
    </script>

    <%- include("../layouts/footer") %>