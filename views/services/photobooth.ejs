<%- include("../layouts/header", { title: "Photobooth" }) %>

    <style>
        .photobooth-wrapper {
            height: calc(100vh - 120px);
            overflow-y: auto;
            padding-bottom: 120px;
        }

        .text-white.text-center .photobooth-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .text-white.text-center .photobooth-icon img {
            width: auto;
            /* Mengatur lebar gambar */
            height: 36px;
            /* Mengatur tinggi gambar */
        }


        .btn-back-custom {
            position: fixed;
            bottom: 50px;
            /* Letakkan tombol di bagian bawah layar */
            left: 50%;
            transform: translateX(-50%);
            /* Posisikan tombol ke tengah */
            width: 80%;
            padding: 12px 28px;
            text-decoration: none;
            border-radius: 12px;
            background: #0c2340;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.15), 0 0 16px rgba(0, 255, 255, 0.06);
            z-index: 999;
            /* Pastikan tombol tetap berada di atas */
        }

        .btn-back-custom:hover {
            background: #1e3651;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.15), 0 0 25px rgba(0, 255, 255, 0.06);
        }
    </style>

    <div class="text-white text-center mt-5 mb-2">
        <div class="photobooth-icon">
            <img src="assets/icon/photobooth.png" alt="Photobooth">
        </div>
    </div>

    <div class="photobooth-wrapper">
        <div class="row mt-4 px-3" id="photosRow">
            <% if (photos && photos.length> 0) { %>
                <% photos.forEach((url)=> { %>
                    <div class="col-6 mb-3 text-center" data-url="<%= url %>">
                        <a href="<%= url %>" target="_blank">
                            <img class="img-fluid rounded shadow photo-img" data-src="<%= url %>" alt="Photo" />
                        </a>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <p class="text-center">No photos available.</p>
                            <% } %>
        </div>
    </div>

    <a href="/dashboard" class="btn-back-custom">BACK</a>


    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>

    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyDG7V8hgvDVa7cSYrkjWOLsBnwOv_5WVyc",
            authDomain: "gustbook-test.firebaseapp.com",
            databaseURL: "https://gustbook-test-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "gustbook-test",
            storageBucket: "gustbook-test.appspot.com",
            messagingSenderId: "756925029571",
            appId: "1:756925029571:web:562ee8486d4bba2be95676"
        };
        firebase.initializeApp(firebaseConfig);

        const userId = "<%= user.id %>";
        const photosRow = document.getElementById("photosRow");

        // Fungsi untuk konversi Google Drive URL ke thumbnail
        function driveThumbnail(url) {
            if (!url) return null;

            let fileId = null;

            // /file/d/FILE_ID/view
            let match = url.match(/\/file\/d\/([^/]+)/);
            if (match) fileId = match[1];

            // id=FILE_ID
            match = url.match(/id=([^&]+)/);
            if (!fileId && match) fileId = match[1];

            // /d/FILE_ID
            match = url.match(/\/d\/([^/]+)/);
            if (!fileId && match) fileId = match[1];

            if (!fileId) return url;

            // solusi ke-2 (yang Anda minta)
            return `https://drive.google.com/thumbnail?id=${fileId}`;
        }





        window.onload = function () {
            document.querySelectorAll(".photo-img").forEach(img => {
                const src = img.getAttribute("data-src");
                const thumbUrl = driveThumbnail(src); // Memastikan variabel terdefinisi
                console.log("Setting Image URL:", thumbUrl); // Debug log untuk memastikan nilai
                img.src = thumbUrl; // Memastikan thumbnail ditetapkan ke src gambar
            });
        };

        // Cek URL yang sudah ada untuk mencegah duplikasi
        const existingPhotos = new Set();
        document.querySelectorAll('#photosRow [data-url]').forEach(el => {
            existingPhotos.add(el.getAttribute('data-url'));
        });

        // Fungsi tambah foto baru realtime
        function addPhoto(url) {
            if (existingPhotos.has(url)) return;
            existingPhotos.add(url);

            const thumb = driveThumbnail(url);
            const div = document.createElement("div");
            div.classList.add("col-6", "mb-3", "text-center");
            div.setAttribute("data-url", url);

            div.innerHTML = `
            <a href="${url}" target="_blank">
                <img src="${thumb}" class="img-fluid rounded shadow" alt="Photo" />
            </a>
        `;

            photosRow.prepend(div);
        }

        // Listener realtime untuk foto baru
        firebase.database().ref(`users/${userId}/photos`).on("child_added", snap => {
            addPhoto(snap.val());
        });
    </script>

    <%- include("../layouts/footer") %>