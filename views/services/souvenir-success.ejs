<%- include("../layouts/header", { title: "Souvenir" }) %>

<style>
    body {
        background: url("/assets/img/souvenir.png") no-repeat center top/cover !important;
        min-height: 100vh;
        color: #fff;
        text-align: center;
        font-family: 'Poppins', sans-serif;
    }

    .souvenir-wrapper {
        margin-top: 180px;
        /* turun sedikit biar pas seperti di desain */
        padding: 0 20px;
    }

    .souvenir-title {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 2px;
        color: #ffffff;
    }


    .souvenir-text {
        margin-top: 32px;
        font-size: 1.2rem;
        line-height: 1.6;
        font-weight: 400;
    }

    /* Tombol BACK versi neon navy */
    .btn-back-custom {
        display: block;
        width: 80%;
        max-width: 300px;
        margin: 40px auto 0;
        padding: 14px 0;
        border-radius: 14px;

        background: #0c2340;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;

        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
            0 0 12px rgba(0, 255, 255, 0.2),
            0 0 20px rgba(0, 255, 255, 0.1);

        transition: all 0.25s ease;
    }

    .btn-back-custom:hover {
        transform: translateY(-2px);
        box-shadow:
            0 0 18px rgba(0, 255, 255, 0.35),
            0 0 30px rgba(0, 255, 255, 0.2);
        color: #fff;
    }
</style>

<div class="souvenir-wrapper">

    <h2 class="souvenir-title d-flex align-items-center justify-content-center gap-2">
        <span class="material-symbols-rounded" style="font-size: 36px;">card_giftcard</span>
        SOUVENIR
    </h2>


    <p class="souvenir-text">
        Thank you!<br>
        You are eligible to receive<br>
        your souvenir.<br><br>
        Please do not close this page<br>
        before collecting your souvenir.
    </p>

    <a href="javascript:void(0)" onclick="confirmBack()" class="btn-back-custom">BACK</a>

</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function confirmBack() {
        Swal.fire({
            title: "Are you sure?",
            text: "Return to dashboard?",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes",
            cancelButtonText: "No"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/dashboard";
            }
        });
    }
</script>

<%- include("../layouts/footer") %>