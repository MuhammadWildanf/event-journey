<%- include("../layouts/header", { title: "Lunch Box" }) %>

<style>
    body {
        background: url("/assets/img/lunch.png") no-repeat center top/cover !important;
        min-height: 100vh;
        color: #fff;
        text-align: center;
        font-family: 'Poppins', sans-serif;
    }

    .page-wrapper {
        margin-top: 180px; /* sesuai desain */
        padding: 0 20px;
    }

    /* TITLE */
    .title-lunch {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px; /* jarak icon-text */
    }

    .title-lunch .material-symbols-rounded {
        font-size: 36px; /* mirip desain */
        color: #ffffff;
        font-weight: 400;
    }

    /* DESCRIPTION */
    .desc-text {
        margin-top: 32px;
        font-size: 1.2rem;
        line-height: 1.6;
        font-weight: 400;
    }

    /* BUTTON */
    .btn-back-custom {
        display: block;
        width: 80%;
        max-width: 300px;
        margin: 40px auto 0;
        padding: 14px 0;
        border-radius: 14px;

        background: #0c2340;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        text-decoration: none;

        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow:
            0 0 12px rgba(0, 255, 255, 0.2),
            0 0 20px rgba(0, 255, 255, 0.1);

        transition: 0.25s;
    }

    .btn-back-custom:hover {
        transform: translateY(-2px);
        box-shadow:
            0 0 18px rgba(0, 255, 255, 0.35),
            0 0 30px rgba(0, 255, 255, 0.2);
    }
</style>

<div class="page-wrapper">

    <h2 class="title-lunch">
        <span class="material-symbols-rounded">restaurant</span>
        LUNCH BOX
    </h2>

    <p class="desc-text">
        Thank you!<br>
        You are eligible to receive<br>
        your lunch box.<br><br>
        Please do not close this page<br>
        before collecting your lunch box.
    </p>

    <a href="/dashboard" class="btn-back-custom">BACK</a>

</div>

<%- include("../layouts/footer") %>
