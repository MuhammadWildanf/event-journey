<%- include("../layouts/header", { title: "Guestbook || SCM Digital Day 2025" }) %>

    <style>
        /* Importing Montserrat font */
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600&display=swap');

        /* General Styling */
        body {
            background: url("/assets/img/bg-dashboard.png") no-repeat center top/cover;

            font-family: 'Montserrat', sans-serif;
        }

        .text-white.text-center .guestbook-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
        }

        .text-white.text-center .guestbook-icon img {
            width: auto;
            height: 36px;
        }

        /* Form Styling */
        form {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .form-group {
            margin-bottom: 20px;
        }

        /* Short Message Textarea */
        #comment {
            border-radius: 10px;
            padding: 10px;
            width: 100%;
            height: 100px;
            font-family: 'Montserrat', sans-serif;
        }

        /* Character Card Styling */
        .character-selection {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .character-card {
            width: 100px;
            height: 160px;
            margin: 10px;
            border-radius: 15px;
            background-color: white;
            border: 2px solid #ccc;
            text-align: center;
            cursor: pointer;
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Highlight the card when selected */
        .character-card.selected {
            background-color: #c2ff37;
            /* Base background color */
            background-image: radial-gradient(circle at center, rgba(194, 255, 55, 1) 0%, rgba(194, 255, 55, 0.8) 30%, rgba(194, 255, 55, 0.5) 60%, rgba(194, 255, 55, 0.2) 80%, rgba(194, 255, 55, 0) 100%);
            /* Enhanced radial gradient */
            border-color: #66b800;
            /* Border color */
            box-shadow: 0 0 20px rgba(102, 184, 0, 0.8), inset 0 0 30px rgba(194, 255, 55, 0.3);
            /* Enhanced green shadow with inset glow */
            border-radius: 15px;
            /* Rounded corners */
            transition: all 0.3s ease;
            transform: scale(1.05);
        }

        .character-card img {
            width: 100%;
            height: 100%;
            /* Ensures the image fills the card height */
            object-fit: contain;
        }

        /* Custom Send Button */
        .btn-send {
            background-color: #c2ff37;
            /* Base background color */
            background-image: radial-gradient(circle at center, rgba(194, 255, 55, 1) 0%, rgba(194, 255, 55, 0.9) 40%, rgba(194, 255, 55, 0.6) 70%, rgba(194, 255, 55, 0.3) 90%, rgba(194, 255, 55, 0) 100%);
            /* Enhanced radial gradient */
            color: black;
            /* Text color */
            border: 2px solid #66b800;
            /* Border to match the character card */
            padding: 15px 30px;
            /* Larger padding for better aesthetics */
            font-size: 18px;
            /* Larger font size */
            font-weight: bold;
            /* Bold text */
            border-radius: 30px;
            /* Rounded corners for the button */
            cursor: pointer;
            /* Pointer cursor on hover */
            width: 100%;
            text-align: center;
            transition: all 0.3s ease;
            /* Smooth transitions for hover */
            margin-top: 20px;
            box-shadow: 0 4px 15px rgba(102, 184, 0, 0.4), inset 0 2px 10px rgba(255, 255, 255, 0.2);
        }

        /* Button hover effect */
        .btn-send:hover {
            background-color: #66b800;
            background-image: radial-gradient(circle at center, rgba(102, 184, 0, 1) 0%, rgba(102, 184, 0, 0.9) 40%, rgba(102, 184, 0, 0.6) 70%, rgba(102, 184, 0, 0.3) 90%, rgba(102, 184, 0, 0) 100%);
            /* Enhanced radial gradient on hover */
            transform: scale(1.05);
            /* Slightly enlarge the button on hover */
            box-shadow: 0 6px 20px rgba(102, 184, 0, 0.6), inset 0 2px 10px rgba(255, 255, 255, 0.3);
            /* Enhanced green shadow effect */
        }

        /* Responsive Adjustments */
        @media screen and (max-width: 600px) {
            .character-card {
                width: 90px;
                height: 140px;
            }

            .character-selection {
                justify-content: center;
            }

            .btn-send {
                padding: 12px;
            }
        }

        @media screen and (max-width: 400px) {
            form {
                padding: 15px;
            }

            .character-card {
                width: 70px;
                height: 120px;
            }

            .btn-send {
                padding: 10px;
            }
        }
    </style>

    <div class="text-white text-center mt-5 mb-2">
        <div class="guestbook-icon">
            <img src="assets/icon/guestbook.png" alt="Guestbook">
        </div>
    </div>

    <div class="text-center mt-5">
        <form id="guestbookForm" action="/guestbook/submit-form" method="POST">
            <div class="form-group mb-3">
                <label for="comment">Short Message</label>
                <textarea class="form-control" name="comment" id="comment" rows="3" maxlength="80"></textarea>
            </div>

            <div class="form-group mb-3">
                <label for="char">Choose Avatar</label>
                <div class="character-selection">
                    <div class="character-card" id="char-1" onclick="selectCharacter(1)">
                        <img src="assets/char/1.png" alt="Character 1">
                    </div>
                    <div class="character-card" id="char-2" onclick="selectCharacter(2)">
                        <img src="assets/char/2.png" alt="Character 2">
                    </div>
                    <div class="character-card" id="char-3" onclick="selectCharacter(3)">
                        <img src="assets/char/3.png" alt="Character 3">
                    </div>
                </div>
                <!-- Hidden input untuk character, akan di-update oleh JavaScript -->
                <input type="hidden" name="char" id="char-input" value="1">
            </div>

            <button type="submit" class="btn-send">SEND</button>
        </form>
    </div>

    <script>
        let selectedCharacter = null;

        // Handle character selection
        function selectCharacter(charId) {
            // Deselect previous character
            if (selectedCharacter) {
                document.getElementById(`char-${selectedCharacter}`).classList.remove("selected");
            }

            // Select the new character
            selectedCharacter = charId;
            document.getElementById(`char-${charId}`).classList.add("selected");

            // Update hidden input field with the selected character id
            const hiddenInput = document.getElementById("char-input");
            if (hiddenInput) {
                hiddenInput.value = charId;
            }
        }

        // Handle form submission with AJAX
        document.getElementById("guestbookForm").addEventListener("submit", async function(e) {
            e.preventDefault();

            // Get form data
            const formData = new FormData(this);
            
            // Check if character is selected (from hidden input)
            const charValue = formData.get("char");
            const commentValue = formData.get("comment");
            
            // Debug: log form data
            console.log("Form data:", {
                char: charValue,
                comment: commentValue,
                charType: typeof charValue
            });
            
            if (!charValue || charValue === "" || charValue === "0") {
                Swal.fire({
                    icon: "warning",
                    title: "Character Required",
                    text: "Please select a character first!",
                    confirmButtonColor: "#c2ff37",
                });
                return;
            }
            
            try {
                // Send as JSON to ensure proper parsing
                // Convert char to number (not string)
                const response = await fetch("/guestbook/submit-form", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        char: Number(charValue), // Convert to number
                        comment: commentValue
                    })
                });

                const data = await response.json();

                if (data.success) {
                    // Show success alert
                    Swal.fire({
                        icon: "success",
                        title: "Thank You!",
                        text: data.message || "Thank you for participating!",
                        confirmButtonColor: "#c2ff37",
                        confirmButtonText: "OK",
                        timer: 2000,
                        timerProgressBar: true
                    }).then(() => {
                        // Redirect to dashboard after alert
                        window.location.href = data.redirect || "/dashboard";
                    });
                } else {
                    // Show error alert
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: data.message || "Something went wrong. Please try again.",
                        confirmButtonColor: "#c2ff37",
                    });
                }
            } catch (error) {
                console.error("Error:", error);
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "An error occurred. Please try again.",
                    confirmButtonColor: "#c2ff37",
                });
            }
        });

        // Initialize the character selection to make sure character 1 is selected by default
        document.addEventListener("DOMContentLoaded", function () {
            selectCharacter(1);  // Default selection
        });

    </script>

    <%- include("../layouts/footer") %>