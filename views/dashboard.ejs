<%- include("./layouts/header", { title: "Dashboard" , bodyClass: "page-dashboard" }) %>

  <header class="d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <div>
        <small>Welcome</small><br>
        <strong>
          <%= user.name %>
        </strong>
      </div>
    </div>
    <a href="/logout" class="logout-btn text-white text-decoration-none">
      <span class="material-symbols-rounded logout-icon">logout</span>
    </a>
  </header>

  <%
  const featureStatus = {
    scan: true,
    lunch: user.lunch_claimed ?? false,
    souvenir: user.souvenir_claimed ?? false,
    photobooth: user.photobooth_done ?? false,
    games: false,
    booth: (user.visited_count ?? 0) >= 1
  };

  const nv = (v) => (v ? "" : "not-visited");
%>
  
  <main>
    <div class="container text-center">
      <div class="row justify-content-center g-3">
         <div class="col-12">
          <a href="/scan" class="text-decoration-none">
            <div class="booth-card booth-scan">
             <span class="material-symbols-rounded">qr_code_scanner</span>
             Scan QR Booth
            </div>
          </a>
        </div>
        <div class="col-6">
          <a href="/lunch" class="text-decoration-none">
           <div class="booth-card booth-lunch <%= nv(featureStatus.lunch) %>">
             <span class="material-symbols-rounded">restaurant</span>
              LUNCH BOX
            </div>
          </a>
        </div>
        <div class="col-6">
          <a href="/souvenir" class="text-decoration-none">
           <div class="booth-card booth-souvenir <%= nv(featureStatus.souvenir) %>">
             <span class="material-symbols-rounded">card_giftcard</span>
             SOUVENIR
            </div>
          </a>
        </div>
        <div class="col-6">
          <a href="/photobooth" class="text-decoration-none">
          <div class="booth-card booth-photo <%= nv(featureStatus.photobooth) %>">
             <span class="material-symbols-rounded">photo_camera</span>
             PHOTOBOOTH
            </div>
          </a>
        </div>
        <div class="col-6">
          <a href="/games" class="text-decoration-none">
           <div class="booth-card booth-games <%= nv(featureStatus.games) %>">
            <span class="material-symbols-rounded">stadia_controller</span>
              GAMES
            </div>
          </a>
        </div>
        <div class="col-12">
          <a href="/booth" class="text-decoration-none">
           <div class="booth-card booth-main w-100 <%= nv(featureStatus.booth) %>">
             <span class="material-symbols-rounded">storefront</span>
            BOOTH
            </div>
          </a>
        </div>
      </div>
    </div>
  </main>

  <%- include("./layouts/footer") %>