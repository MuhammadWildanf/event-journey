<%- include("./layouts/header", { title: "Dashboard || SCM Digital Day 2025" }) %>
  <header class="d-flex flex-column justify-content-center align-items-center py-4">
    <!-- Logo Section -->
    <div class="logo-container text-center">
      <img src="/assets/img/logo.png" alt="SCM Digital Day 2025 Logo" class="logo-img" />
    </div>

    <!-- User Name Section -->
    <div class="user-info text-center">
      <strong>
        Welcome <%= user.name %>
      </strong>
    </div>
  </header>

  <% const btn=(url, active, classes, card)=> {
    const href = active ? url : "javascript:void(0)";
    const nvClass = active ? "" : "not-visited";
    return `
    <a href="${href}" class="${classes}">
      <div class="booth-card ${card} ${nvClass}"></div>
    </a>
    `;
    };
    %>

    <main>
      <div class="dashboard-grid">

        <!-- Always active -->
        <a href="/scan" class="grid-item wide">
          <div class="booth-card card-scan"></div>
        </a>

        <%- btn('/lunch', user.lunch_active, 'grid-item square' , 'card-lunch' ) %>
          <%- btn('/souvenir', user.souvenir_active, 'grid-item square' , 'card-souvenir' ) %>
            <%- btn('/photobooth', user.photobooth_active, 'grid-item square' , 'card-photo' ) %>
              <%- btn('/games', user.games_active, 'grid-item square' , 'card-games' ) %>
                <%- btn('/booth', user.booth_active, 'grid-item wide' , 'card-booth' ) %>

                  <div class="download-guide">
                    <!-- <a class="download-link" href="/assets/files/QR.pdf" download target="_blank" rel="noopener"> -->
                    <a class="download-link" href="/event-guide" rel="noopener">
                      EVENT GUIDE
                    </a>
                  </div>
      </div>
    </main>

    <%- include("./layouts/footer") %>